{
 "title": "pr-runtime",
 "uid": "pr-runtime",
 "timezone": "browser",
 "refresh": "5s",
 "time": {
  "from": "now-10m",
  "to": "now"
 },
 "schemaVersion": 39,
 "version": 1,
 "tags": [
  "pr-runtime"
 ],
 "panels": [
  {
   "type": "timeseries",
   "title": "SQS queue",
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 8,
    "h": 10
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "expr": "max(prr_queue_visible)",
     "legendFormat": "waiting",
     "refId": "A"
    },
    {
     "expr": "max(prr_queue_inflight)",
     "legendFormat": "running",
     "refId": "B"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "decimals": 0,
     "min": 0,
     "custom": {
      "lineWidth": 3,
      "fillOpacity": 15,
      "lineInterpolation": "stepAfter",
      "stacking": {
       "mode": "normal"
      }
     }
    },
    "overrides": [
     {
      "matcher": {
       "id": "byName",
       "options": "waiting"
      },
      "properties": [
       {
        "id": "color",
        "value": {
         "mode": "fixed",
         "fixedColor": "orange"
        }
       }
      ]
     },
     {
      "matcher": {
       "id": "byName",
       "options": "running"
      },
      "properties": [
       {
        "id": "color",
        "value": {
         "mode": "fixed",
         "fixedColor": "yellow"
        }
       }
      ]
     }
    ]
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   }
  },
  {
   "type": "timeseries",
   "title": "Runner pods (KEDA)",
   "gridPos": {
    "x": 8,
    "y": 0,
    "w": 8,
    "h": 10
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "expr": "max(kube_horizontalpodautoscaler_status_desired_replicas{horizontalpodautoscaler=\"keda-hpa-runner\"})",
     "legendFormat": "KEDA target",
     "refId": "A"
    },
    {
     "expr": "count(max by (pod) (kube_pod_status_ready{namespace=\"pr-runtime\",pod=~\"runner-.*\",condition=\"true\"}) == 1) or vector(0)",
     "legendFormat": "ready",
     "refId": "B"
    },
    {
     "expr": "count(max by (pod) (kube_pod_status_phase{namespace=\"pr-runtime\",pod=~\"runner-.*\",phase=\"Pending\"}) == 1) or vector(0)",
     "legendFormat": "pending",
     "refId": "C"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "decimals": 0,
     "min": 0,
     "custom": {
      "lineWidth": 3,
      "fillOpacity": 15,
      "lineInterpolation": "stepAfter",
      "stacking": {
       "mode": "none"
      }
     }
    },
    "overrides": [
     {
      "matcher": {
       "id": "byName",
       "options": "KEDA target"
      },
      "properties": [
       {
        "id": "color",
        "value": {
         "mode": "fixed",
         "fixedColor": "blue"
        }
       },
       {
        "id": "custom.lineStyle",
        "value": {
         "fill": "dash",
         "dash": [
          10,
          8
         ]
        }
       },
       {
        "id": "custom.fillOpacity",
        "value": 0
       }
      ]
     },
     {
      "matcher": {
       "id": "byName",
       "options": "ready"
      },
      "properties": [
       {
        "id": "color",
        "value": {
         "mode": "fixed",
         "fixedColor": "green"
        }
       }
      ]
     },
     {
      "matcher": {
       "id": "byName",
       "options": "pending"
      },
      "properties": [
       {
        "id": "color",
        "value": {
         "mode": "fixed",
         "fixedColor": "red"
        }
       }
      ]
     }
    ]
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   }
  },
  {
   "type": "timeseries",
   "title": "Nodes (Karpenter)",
   "gridPos": {
    "x": 16,
    "y": 0,
    "w": 8,
    "h": 10
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "expr": "count(max by (node) (kube_node_labels{label_eks_amazonaws_com_capacity_type=\"ON_DEMAND\"}))",
     "legendFormat": "fixed on-demand",
     "refId": "A"
    },
    {
     "expr": "count(max by (node) (kube_node_labels{label_karpenter_sh_capacity_type!=\"\"})) or vector(0)",
     "legendFormat": "Karpenter spot",
     "refId": "B"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "decimals": 0,
     "min": 0,
     "custom": {
      "lineWidth": 3,
      "fillOpacity": 15,
      "lineInterpolation": "stepAfter",
      "stacking": {
       "mode": "none"
      }
     }
    },
    "overrides": [
     {
      "matcher": {
       "id": "byName",
       "options": "fixed on-demand"
      },
      "properties": [
       {
        "id": "color",
        "value": {
         "mode": "fixed",
         "fixedColor": "blue"
        }
       }
      ]
     },
     {
      "matcher": {
       "id": "byName",
       "options": "Karpenter spot"
      },
      "properties": [
       {
        "id": "color",
        "value": {
         "mode": "fixed",
         "fixedColor": "green"
        }
       }
      ]
     }
    ]
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   }
  },
  {
   "type": "stat",
   "title": "Waiting for a runner (in SQS + admitted)",
   "gridPos": {
    "x": 0,
    "y": 10,
    "w": 6,
    "h": 5
   },
   "targets": [
    {
     "expr": "max(prr_queue_visible) + max(prr_tasks_pending)",
     "legendFormat": "waiting",
     "refId": "A"
    }
   ],
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 12,
      "stacking": {
       "mode": "none"
      }
     }
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "value",
    "graphMode": "area",
    "textMode": "value"
   }
  },
  {
   "type": "stat",
   "title": "Busy runners",
   "gridPos": {
    "x": 6,
    "y": 10,
    "w": 6,
    "h": 5
   },
   "targets": [
    {
     "expr": "max(prr_runners_busy)",
     "legendFormat": "busy",
     "refId": "A"
    }
   ],
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 12,
      "stacking": {
       "mode": "none"
      }
     }
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "value",
    "graphMode": "area",
    "textMode": "value"
   }
  },
  {
   "type": "stat",
   "title": "Idle warm runners",
   "gridPos": {
    "x": 12,
    "y": 10,
    "w": 6,
    "h": 5
   },
   "targets": [
    {
     "expr": "max(prr_runners_idle)",
     "legendFormat": "idle",
     "refId": "A"
    }
   ],
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 12,
      "stacking": {
       "mode": "none"
      }
     }
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "value",
    "graphMode": "area",
    "textMode": "value"
   }
  },
  {
   "type": "stat",
   "title": "In LLM review",
   "gridPos": {
    "x": 18,
    "y": 10,
    "w": 6,
    "h": 5
   },
   "targets": [
    {
     "expr": "max(prr_reviews_in_flight)",
     "legendFormat": "reviewing",
     "refId": "A"
    }
   ],
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 12,
      "stacking": {
       "mode": "none"
      }
     }
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "value",
    "graphMode": "area",
    "textMode": "value"
   }
  },
  {
   "type": "timeseries",
   "title": "Queue, pool and admission",
   "gridPos": {
    "x": 0,
    "y": 15,
    "w": 12,
    "h": 9
   },
   "targets": [
    {
     "expr": "max(prr_queue_visible)",
     "legendFormat": "in SQS (not yet leased)",
     "refId": "Q"
    },
    {
     "expr": "max(prr_tasks_pending)",
     "legendFormat": "admitted, waiting",
     "refId": "A"
    },
    {
     "expr": "max(prr_runners_busy)",
     "legendFormat": "busy",
     "refId": "B"
    },
    {
     "expr": "max(prr_runners_idle)",
     "legendFormat": "idle",
     "refId": "C"
    },
    {
     "expr": "max(prr_queue_visible) + max(prr_tasks_pending) + max(prr_runners_busy)",
     "legendFormat": "backlog (what KEDA sees)",
     "refId": "D"
    },
    {
     "expr": "max(prr_reviews_in_flight)",
     "legendFormat": "in LLM review",
     "refId": "E"
    }
   ],
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 12,
      "stacking": {
       "mode": "none"
      }
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   }
  },
  {
   "type": "timeseries",
   "title": "Admission rejects/s (work waited because busy >= cap)",
   "gridPos": {
    "x": 12,
    "y": 15,
    "w": 12,
    "h": 9
   },
   "targets": [
    {
     "expr": "sum(rate(prr_admission_rejects_total[30s]))",
     "legendFormat": "rejects/s",
     "refId": "A"
    },
    {
     "expr": "sum(rate(prr_cold_assignments_total[30s]))",
     "legendFormat": "cold assigns/s",
     "refId": "B"
    }
   ],
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 12,
      "stacking": {
       "mode": "none"
      }
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   }
  },
  {
   "type": "timeseries",
   "title": "Time to comment (webhook -> review posted)",
   "gridPos": {
    "x": 0,
    "y": 24,
    "w": 12,
    "h": 9
   },
   "targets": [
    {
     "expr": "histogram_quantile(0.5, sum(rate(prr_time_to_comment_seconds_bucket[2m])) by (le))",
     "legendFormat": "p50",
     "refId": "A"
    },
    {
     "expr": "histogram_quantile(0.95, sum(rate(prr_time_to_comment_seconds_bucket[2m])) by (le))",
     "legendFormat": "p95",
     "refId": "B"
    }
   ],
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "s",
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 12,
      "stacking": {
       "mode": "none"
      }
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   }
  },
  {
   "type": "timeseries",
   "title": "Wait for runner (admitted -> assigned)",
   "gridPos": {
    "x": 12,
    "y": 24,
    "w": 12,
    "h": 9
   },
   "targets": [
    {
     "expr": "histogram_quantile(0.5, sum(rate(prr_wait_for_runner_seconds_bucket[2m])) by (le))",
     "legendFormat": "p50",
     "refId": "A"
    },
    {
     "expr": "histogram_quantile(0.95, sum(rate(prr_wait_for_runner_seconds_bucket[2m])) by (le))",
     "legendFormat": "p95",
     "refId": "B"
    }
   ],
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "s",
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 12,
      "stacking": {
       "mode": "none"
      }
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   }
  },
  {
   "type": "timeseries",
   "title": "Phase p50 (s)",
   "gridPos": {
    "x": 0,
    "y": 33,
    "w": 12,
    "h": 9
   },
   "targets": [
    {
     "expr": "histogram_quantile(0.5, sum(rate(prr_phase_seconds_bucket[5m])) by (le, phase))",
     "legendFormat": "{{phase}}",
     "refId": "A"
    }
   ],
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "s",
     "custom": {
      "lineWidth": 2,
