    },
    "tooltip": {
     "mode": "multi"
    }
   }
  },
  {
   "type": "timeseries",
   "title": "Throughput and spend",
   "gridPos": {
    "x": 12,
    "y": 33,
    "w": 12,
    "h": 9
   },
   "targets": [
    {
     "expr": "sum(rate(prr_tasks_total{state=\"posted\"}[1m]))*60",
     "legendFormat": "posted/min",
     "refId": "A"
    },
    {
     "expr": "sum(rate(prr_cost_usd_total{kind=\"tokens\"}[1m]))*3600",
     "legendFormat": "tokens $/hr",
     "refId": "B"
    },
    {
     "expr": "sum(rate(prr_cost_usd_total{kind=\"compute\"}[1m]))*3600",
     "legendFormat": "compute $/hr (marginal)",
     "refId": "C"
    }
   ],
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 12,
      "stacking": {
       "mode": "none"
      }
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   }
  },
  {
   "type": "timeseries",
   "title": "Runner pods (kube-state-metrics)",
   "gridPos": {
    "x": 0,
    "y": 42,
    "w": 24,
    "h": 8
   },
   "targets": [
    {
     "expr": "count(max by (pod) (kube_pod_status_phase{namespace=\"pr-runtime\",pod=~\"runner-.*\",phase=\"Running\"}) == 1) or vector(0)",
     "legendFormat": "running",
     "refId": "A"
    },
    {
     "expr": "count(max by (pod) (kube_pod_status_phase{namespace=\"pr-runtime\",pod=~\"runner-.*\",phase=\"Pending\"}) == 1) or vector(0)",
     "legendFormat": "pending",
     "refId": "B"
    }
   ],
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 12,
