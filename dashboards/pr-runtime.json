{
 "title": "pr-runtime",
 "uid": "pr-runtime",
 "timezone": "browser",
 "refresh": "5s",
 "time": {
  "from": "now-15m",
  "to": "now"
 },
 "schemaVersion": 39,
 "version": 1,
 "tags": [
  "pr-runtime"
 ],
 "panels": [
  {
   "type": "stat",
   "title": "Pending (admitted, waiting for a runner)",
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 6,
    "h": 5
   },
   "targets": [
    {
     "expr": "max(prr_tasks_pending)",
     "legendFormat": "pending",
     "refId": "A"
    }
   ],
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 12,
      "stacking": {
       "mode": "none"
      }
     }
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "value",
    "graphMode": "area",
    "textMode": "value"
   }
  },
  {
   "type": "stat",
   "title": "Busy runners",
   "gridPos": {
    "x": 6,
    "y": 0,
    "w": 6,
    "h": 5
   },
   "targets": [
    {
     "expr": "max(prr_runners_busy)",
     "legendFormat": "busy",
     "refId": "A"
    }
   ],
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 12,
      "stacking": {
       "mode": "none"
      }
     }
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "value",
    "graphMode": "area",
    "textMode": "value"
   }
  },
  {
   "type": "stat",
   "title": "Idle warm runners",
   "gridPos": {
    "x": 12,
    "y": 0,
    "w": 6,
    "h": 5
   },
   "targets": [
    {
     "expr": "max(prr_runners_idle)",
     "legendFormat": "idle",
     "refId": "A"
    }
   ],
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 12,
      "stacking": {
       "mode": "none"
      }
     }
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "value",
    "graphMode": "area",
    "textMode": "value"
   }
  },
  {
   "type": "stat",
   "title": "In LLM review",
   "gridPos": {
    "x": 18,
    "y": 0,
    "w": 6,
    "h": 5
   },
   "targets": [
    {
     "expr": "max(prr_reviews_in_flight)",
     "legendFormat": "reviewing",
     "refId": "A"
    }
   ],
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 12,
      "stacking": {
       "mode": "none"
      }
     }
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "value",
    "graphMode": "area",
    "textMode": "value"
   }
  },
  {
   "type": "timeseries",
   "title": "Queue, pool and admission",
   "gridPos": {
    "x": 0,
    "y": 5,
    "w": 12,
    "h": 9
   },
   "targets": [
    {
     "expr": "max(prr_tasks_pending)",
     "legendFormat": "pending",
     "refId": "A"
    },
    {
     "expr": "max(prr_runners_busy)",
     "legendFormat": "busy",
     "refId": "B"
    },
    {
     "expr": "max(prr_runners_idle)",
     "legendFormat": "idle",
     "refId": "C"
    },
    {
     "expr": "max(prr_tasks_pending) + max(prr_runners_busy)",
     "legendFormat": "pending+busy",
     "refId": "D"
    },
    {
     "expr": "max(prr_reviews_in_flight)",
     "legendFormat": "in LLM review",
     "refId": "E"
    }
   ],
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 12,
      "stacking": {
       "mode": "none"
      }
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   }
  },
  {
   "type": "timeseries",
   "title": "Admission rejects/s (work waited because busy >= cap)",
   "gridPos": {
    "x": 12,
    "y": 5,
    "w": 12,
    "h": 9
   },
   "targets": [
    {
     "expr": "sum(rate(prr_admission_rejects_total[30s]))",
     "legendFormat": "rejects/s",
     "refId": "A"
    },
    {
     "expr": "sum(rate(prr_cold_assignments_total[30s]))",
     "legendFormat": "cold assigns/s",
     "refId": "B"
    }
   ],
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 12,
      "stacking": {
       "mode": "none"
      }
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   }
  },
  {
   "type": "timeseries",
   "title": "Time to comment (webhook -> review posted)",
   "gridPos": {
    "x": 0,
    "y": 14,
    "w": 12,
    "h": 9
   },
   "targets": [
    {
     "expr": "histogram_quantile(0.5, sum(rate(prr_time_to_comment_seconds_bucket[2m])) by (le))",
     "legendFormat": "p50",
     "refId": "A"
    },
    {
     "expr": "histogram_quantile(0.95, sum(rate(prr_time_to_comment_seconds_bucket[2m])) by (le))",
     "legendFormat": "p95",
     "refId": "B"
    }
   ],
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "s",
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 12,
      "stacking": {
       "mode": "none"
      }
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   }
  },
  {
   "type": "timeseries",
   "title": "Wait for runner (admitted -> assigned)",
   "gridPos": {
    "x": 12,
    "y": 14,
    "w": 12,
    "h": 9
   },
   "targets": [
    {
     "expr": "histogram_quantile(0.5, sum(rate(prr_wait_for_runner_seconds_bucket[2m])) by (le))",
     "legendFormat": "p50",
     "refId": "A"
    },
    {
     "expr": "histogram_quantile(0.95, sum(rate(prr_wait_for_runner_seconds_bucket[2m])) by (le))",
     "legendFormat": "p95",
     "refId": "B"
    }
   ],
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "s",
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 12,
      "stacking": {
       "mode": "none"
      }
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   }
  },
  {
   "type": "timeseries",
   "title": "Phase p50 (s)",
   "gridPos": {
    "x": 0,
    "y": 23,
    "w": 12,
    "h": 9
   },
   "targets": [
    {
     "expr": "histogram_quantile(0.5, sum(rate(prr_phase_seconds_bucket[5m])) by (le, phase))",
     "legendFormat": "{{phase}}",
     "refId": "A"
    }
   ],
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "s",
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 12,
      "stacking": {
       "mode": "none"
      }
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   }
  },
  {
   "type": "timeseries",
   "title": "Throughput: tasks posted/min and LLM tokens/min",
   "gridPos": {
    "x": 12,
    "y": 23,
    "w": 12,
    "h": 9
   },
   "targets": [
    {
     "expr": "sum(rate(prr_tasks_total{state=\"posted\"}[1m]))*60",
     "legendFormat": "posted/min",
     "refId": "A"
    },
    {
     "expr": "sum(rate(prr_llm_tokens_total[1m]))*60/1000",
     "legendFormat": "k tokens/min",
     "refId": "B"
    }
   ],
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 12,
      "stacking": {
       "mode": "none"
      }
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   }
  },
  {
   "type": "timeseries",
   "title": "Runner pods (kube-state-metrics)",
   "gridPos": {
    "x": 0,
    "y": 32,
    "w": 24,
    "h": 8
   },
   "targets": [
    {
     "expr": "count(kube_pod_status_phase{namespace=\"pr-runtime\",pod=~\"runner-.*\",phase=\"Running\"})",
     "legendFormat": "running",
     "refId": "A"
    },
    {
     "expr": "count(kube_pod_status_phase{namespace=\"pr-runtime\",pod=~\"runner-.*\",phase=\"Pending\"})",
     "legendFormat": "pending",
     "refId": "B"
    }
   ],
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 12,
      "stacking": {
       "mode": "none"
      }
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   }
  }
 ],
 "templating": {
  "list": []
 }
}